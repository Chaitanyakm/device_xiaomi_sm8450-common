# XiaomiParts
allow system_app {
  activity_task_service
  app_api_service
  audioserver_service
  cameraserver_service
  content_capture_service
  device_state_service
  drmserver_service
  game_service
  gpu_service
  hint_service
  media_session_service
  mediaextractor_service
  mediametrics_service
  mediaserver_service
  netstats_service
  permission_checker_service
  sensorservice_service
  statusbar_service
  surfaceflinger_service
  thermal_service
  trust_service
  voiceinteraction_service
}:service_manager find;

binder_call(system_app, gpuservice)

# LEDs / cgroup / thermal
allow system_app sysfs_leds:dir search;
allow system_app sysfs_leds:{ file lnk_file } rw_file_perms;
allow system_app {
  cgroup
  sysfs_thermal
}:{ file lnk_file } rw_file_perms;
r_dir_file(system_app, sysfs_thermal)

# CPU / proc
allow system_app sysfs_devices_system_cpu:dir search;
allow system_app sysfs_devices_system_cpu:file r_file_perms;
allow system_app proc_stat:file r_file_perms;

# Properties
get_prop(system_app, settingslib_prop)
get_prop(system_app, aux_camera_control_prop)
set_prop(system_app, aux_camera_control_prop)
